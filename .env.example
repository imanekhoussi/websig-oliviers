# ============================================================
#  WebSIG Oliviers — Variables d'environnement
#  Copier ce fichier en .env et remplir les valeurs réelles.
#  NE PAS committer .env dans git.
# ============================================================

# ── Clés API ────────────────────────────────────────────────
# Clé Groq (LLaMA 3.3) — https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé Google Generative AI (si utilisée)
GOOGLE_API_KEY=

# ── Réseau ──────────────────────────────────────────────────
# Port exposé du frontend (défaut : 80)
FRONTEND_PORT=80

# Origins autorisées pour CORS (séparées par virgule)
# Ajouter l'IP ou domaine de votre serveur en production
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
